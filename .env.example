# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000

# Required for production. Generate a unique random secret of 32+ characters.
API_KEY=
CORS_ORIGIN=http://localhost:3000

POSTGRES_USER=devora
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=devora
DATABASE_URL=postgres://devora:replace-with-a-strong-database-password@localhost:5432/devora
DATABASE_URL_SYNC=postgres://devora:replace-with-a-strong-database-password@localhost:5432/devora?sslmode=disable
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Optional hosted providers
HF_TOKEN=
OPENROUTER_API_KEY=

# Docker-only: bind the API to loopback by default.
API_BIND_ADDRESS=127.0.0.1

# Optional local repository workspace for isolated coding-agent worktrees.
# Set these to directories you control; repositories must live under DEVORA_REPOSITORIES_DIR.
DEVORA_REPOSITORIES_DIR=
DEVORA_WORKTREE_DIR=
